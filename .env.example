# ============================================================
# NHSO Connect Kiosk — Environment Variables
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง
# ค่าอื่นๆ ตั้งค่าผ่านหน้า Admin ได้
# ============================================================

# ========== Admin Login ==========
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# ========== Database HOSxP (แยกตัวแปรเพื่อความปลอดภัย) ==========
# URL จะถูกประกอบอัตโนมัติจากตัวแปรเหล่านี้
# ไม่ต้องใส่ HOSXP_DB_URL อีกต่อไป
DB_ENGINE=mysql+pymysql
DB_USER=your_db_username
DB_PASS=your_db_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hospink

# ========== Options ==========
# เขียน authen_code กลับ HOSxP หลังเคลมสำเร็จ (true/false)
UPDATE_HOSXP_AUTHEN_CODE=true

# เวลา reset หน้า kiosk อัตโนมัติ (วินาที)
KIOSK_AUTO_RESET_SEC=8
